# Copy to .env and fill in. Never commit .env.
# All credentials are read only by the credential broker process.

# Twilio voice (https://console.twilio.com) — free trial is fine
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # trial number you buy in the console
ONCALL_PHONE_NUMBER=        # your verified personal number, E.164 (+1...)
ONCALL_PIN=1234             # keypad PIN required before inbound menu

# PagerDuty Events API v2 (https://developer.pagerduty.com/sign-up)
PAGERDUTY_ROUTING_KEY=      # from a service Events API v2 integration

# Telegram bot (optional; BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local paths (defaults are fine)
MOCK_SECURITY_API_URL=http://127.0.0.1:8101
CREDENTIAL_BROKER_URL=http://127.0.0.1:8102
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
